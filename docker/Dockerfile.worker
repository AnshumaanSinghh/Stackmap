# Background Worker
FROM node:20-alpine AS worker-builder
WORKDIR /app
COPY . .
RUN npm install -g pnpm
RUN pnpm install
RUN pnpm run build --filter=worker

FROM node:20-alpine
WORKDIR /app
COPY --from=worker-builder /app/apps/worker/dist /app/dist
COPY --from=worker-builder /app/apps/worker/package.json /app/package.json
RUN npm install --production

CMD ["node", "dist/index.js"]
