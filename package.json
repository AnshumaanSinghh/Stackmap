{
  "name": "stackmap-cli",
  "version": "1.0.0",
  "description": "Architecture diagrams generated from your code. Maps every service, database, queue and third-party API, with a file:line receipt for each one. Interactive map, Mermaid for your README, PR architecture diffs, MCP server. Zero dependencies.",
  "type": "module",
  "bin": {
    "stackmap": "bin/stackmap.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "action",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "map": "node bin/stackmap.js",
    "verify:catalog": "node scripts/verify-catalog.js",
    "gallery": "node scripts/build-gallery.js",
    "site": "node scripts/build-site.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "architecture",
    "architecture-diagram",
    "system-design",
    "diagram",
    "mermaid",
    "c4",
    "visualization",
    "dependency-graph",
    "monorepo",
    "docker-compose",
    "devtools",
    "cli",
    "github-action",
    "mcp",
    "documentation",
    "onboarding"
  ],
  "author": "Anshumaan Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnshumaanSinghh/Stackmap.git"
  },
  "bugs": {
    "url": "https://github.com/AnshumaanSinghh/Stackmap/issues"
  },
  "homepage": "https://anshumaansinghh.github.io/Stackmap/"
}
